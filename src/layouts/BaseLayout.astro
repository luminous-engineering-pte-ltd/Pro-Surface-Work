---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import '@/styles/global.css';
import { company } from '@/data/services';
import seo from '@/data/seo.json';

type Props = {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  schema?: unknown | unknown[];
};

const { title, description, image = '/images/home-banner.jpeg', imageAlt = `${title} — ${company.name}`, canonical, schema } = Astro.props;
const pageTitle = title.includes(company.name) ? title : `${title} | ${company.name}`;
const pathname = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\/?$/, '/');
const url = new URL(canonical ?? pathname, Astro.site).href;
const socialImage = new URL(image, Astro.site).href;
const noindex = seo.noindexPaths.includes(pathname);
const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: company.name,
  url: new URL('/', Astro.site).href,
  image: new URL('/images/about/pro-surface-works-van.png', Astro.site).href,
  logo: new URL('/update-Pro.png', Astro.site).href,
  sameAs: company.socialProfiles,
  email: company.email,
  telephone: company.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.streetAddress,
    postalCode: company.postalCode,
    addressCountry: 'SG',
    addressLocality: company.location
  },
  areaServed: company.location,
  priceRange: '$$'
};
const schemaItems = [baseSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0], j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src= 'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f); })(window,document,'script','dataLayer','GTM-TVGXN4NW');
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="5pdvZTQLGPZbjaQ1FirtmW729GufOktephexgE2kNYU" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content="en_SG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaItems.length === 1 ? schemaItems[0] : schemaItems)} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TVGXN4NW" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      const header = document.querySelector('.site-header');
      const setHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 16);
      setHeader();
      window.addEventListener('scroll', setHeader, { passive: true });

      const servicesMenu = document.querySelector('[data-services-menu]');
      const servicesToggle = document.querySelector('[data-services-toggle]');
      const closeServicesLinks = document.querySelectorAll('[data-close-services]');
      const hoverServicesQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
      let closeServicesTimer;

      const canHoverServices = () => hoverServicesQuery.matches;

      const setServicesOpen = (isOpen) => {
        window.clearTimeout(closeServicesTimer);
        servicesMenu?.classList.toggle('is-open', isOpen);
        header?.classList.toggle('services-open', isOpen);
        servicesToggle?.setAttribute('aria-expanded', String(isOpen));
      };

      const closeServicesSoon = () => {
        window.clearTimeout(closeServicesTimer);
        closeServicesTimer = window.setTimeout(() => setServicesOpen(false), 180);
      };

      servicesToggle?.addEventListener('click', (event) => {
        event.stopPropagation();
        if (canHoverServices()) {
          setServicesOpen(true);
          return;
        }
        setServicesOpen(!servicesMenu?.classList.contains('is-open'));
      });

      servicesMenu?.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse' && canHoverServices()) {
          setServicesOpen(true);
        }
      });

      servicesMenu?.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse' && canHoverServices()) {
          closeServicesSoon();
        }
      });

      servicesMenu?.addEventListener('focusin', () => setServicesOpen(true));

      servicesMenu?.addEventListener('focusout', (event) => {
        if (!servicesMenu.contains(event.relatedTarget)) {
          closeServicesSoon();
        }
      });

      hoverServicesQuery.addEventListener?.('change', () => setServicesOpen(false));

      document.addEventListener('click', (event) => {
        if (!servicesMenu?.contains(event.target)) {
          setServicesOpen(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setServicesOpen(false);
          document.body.classList.remove('menu-open');
          document.querySelectorAll('[data-menu-toggle]').forEach((button) => {
            button.setAttribute('aria-expanded', 'false');
          });
        }
      });

      closeServicesLinks.forEach((link) => {
        link.addEventListener('click', () => setServicesOpen(false));
      });

      document.querySelectorAll('[data-menu-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const isOpen = !document.body.classList.contains('menu-open');
          document.body.classList.toggle('menu-open', isOpen);
          button.setAttribute('aria-expanded', String(isOpen));
          setServicesOpen(false);
        });
      });

      const mobileServicesWrap = document.querySelector('.mobile-services-wrap');
      const mobileServicesToggle = document.querySelector('[data-mobile-services-toggle]');

      mobileServicesToggle?.addEventListener('click', () => {
        const isOpen = !mobileServicesWrap?.classList.contains('is-open');
        mobileServicesWrap?.classList.toggle('is-open', isOpen);
        mobileServicesToggle.setAttribute('aria-expanded', String(isOpen));
      });

      document.querySelectorAll('.mobile-service-toggle').forEach((button) => {
        button.addEventListener('click', () => {
          const parent = button.closest('.mobile-service');
          const isOpen = !parent?.classList.contains('is-open');
          parent?.classList.toggle('is-open', isOpen);
          button.setAttribute('aria-expanded', String(isOpen));
        });
      });

      document.querySelectorAll('.mobile-panel a').forEach((link) => {
        link.addEventListener('click', () => {
          document.body.classList.remove('menu-open');
          document.querySelectorAll('[data-menu-toggle]').forEach((button) => {
            button.setAttribute('aria-expanded', 'false');
          });
        });
      });

      document.addEventListener('click', (event) => {
        if (document.body.classList.contains('menu-open') && !header?.contains(event.target)) {
          document.body.classList.remove('menu-open');
          document.querySelectorAll('[data-menu-toggle]').forEach((button) => {
            button.setAttribute('aria-expanded', 'false');
          });
        }
      });

      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      document.querySelectorAll('.desktop-nav a, .mobile-panel > a').forEach((link) => {
        const linkPath = new URL(link.href).pathname.replace(/\/$/, '') || '/';
        if (linkPath === currentPath || (linkPath !== '/' && currentPath.startsWith(linkPath))) {
          link.setAttribute('aria-current', 'page');
        }
      });
      if (currentPath.startsWith('/services')) {
        servicesToggle?.setAttribute('aria-current', 'page');
        mobileServicesToggle?.setAttribute('aria-current', 'page');
      }

    </script>
  </body>
</html>
