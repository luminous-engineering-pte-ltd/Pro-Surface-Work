---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import DocumentSections from '@/components/DocumentSections.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { pageCopy, faqSchema } from '@/data/pageCopy';
import { findSubServiceBySlug, services, servicePath, subServicePath, type ServiceCategory, type SubService } from '@/data/services';

export function getStaticPaths() {
  return services.flatMap((service) =>
    service.subServices.map((subService) => ({
      params: { service: service.slug, subservice: subService.slug },
      props: { service, subService }
    }))
  );
}

const { service, subService } = Astro.props as { service: ServiceCategory; subService: SubService };
const page = pageCopy[subService.slug];
if (!page) throw new Error(`Missing imported copy for ${subService.slug}`);

const related = subService.related
  .map((slug) => findSubServiceBySlug(slug) ?? (services.find((item) => item.slug === slug) ? { service: services.find((item) => item.slug === slug)!, subService: undefined } : undefined))
  .filter(Boolean)
  .slice(0, 3);
const pageUrl = subServicePath(service, subService);
const breadcrumbItems = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: servicePath(service), label: service.title },
  { href: pageUrl, label: subService.title }
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: subService.title,
    serviceType: subService.primaryKeyword,
    provider: { '@type': 'LocalBusiness', name: 'Pro Surface Works' },
    areaServed: 'Singapore',
    url: new URL(pageUrl, Astro.site).toString(),
    description: page.description
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: new URL(item.href, Astro.site).toString()
    }))
  },
  faqSchema(page)
].filter(Boolean);
const heading = page.intro.find((block) => block.kind === 'heading')?.text;
const introParagraphs = page.intro.filter((block) => block.kind === 'paragraph');
---

<BaseLayout title={page.title} description={page.description} image={service.image} schema={schema}>
  <section class="hero service-hero" style={`--hero-image: url('${service.image}')`}>
    <div class="container hero-copy">
      <Breadcrumb items={breadcrumbItems} />
      <div class="eyebrow">{service.title}</div>
      <h1>{heading}</h1>
      <p>{introParagraphs[0]?.text}</p>
      <div class="hero-actions">
        <a class="btn light" href="/contact/">Request a Free Assessment</a>
        <a class="btn ghost" href={servicePath(service)}>Back to {service.title}</a>
      </div>
    </div>
  </section>

  {introParagraphs.length > 1 && (
    <section class="section intro-section">
      <div class="container intro-copy">
        {introParagraphs.slice(1).map((block) => <p>{block.text}</p>)}
      </div>
    </section>
  )}

  <DocumentSections page={page} />

  <section class="section related-section">
    <div class="container">
      <div class="related-heading">
        <div class="eyebrow">Related Services</div>
        <h2>Explore related work</h2>
      </div>
      <div class="grid three">
        {related.map((item) => item?.subService ? (
          <ServiceCard title={item.subService.title} summary={item.subService.summary} href={subServicePath(item.service, item.subService)} />
        ) : item ? (
          <ServiceCard title={item.service.title} summary={item.service.summary} href={servicePath(item.service)} />
        ) : null)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero { min-height: 68vh; padding: 118px 0 76px; }
  .intro-section { background: var(--paper); }
  .intro-copy { max-width: 880px; }
  .related-section { background: var(--white); }
  .related-heading { margin-bottom: 30px; }
  .related-heading h2 { margin: 8px 0 0; font-size: clamp(2rem, 3vw, 3rem); }
  @media (max-width: 520px) { .service-hero { min-height: auto; padding: 112px 0 64px; } }
</style>
