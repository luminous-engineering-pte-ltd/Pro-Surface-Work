---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import DocumentSections from '@/components/DocumentSections.astro';
import { pageCopy, faqSchema } from '@/data/pageCopy';
import { services, servicePath, type ServiceCategory } from '@/data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: ServiceCategory };
const page = pageCopy[service.slug];
const pageUrl = servicePath(service);
const breadcrumbItems = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: pageUrl, label: service.title }
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    serviceType: service.primaryKeyword,
    provider: { '@type': 'LocalBusiness', name: 'Pro Surface Works' },
    areaServed: 'Singapore',
    url: new URL(pageUrl, Astro.site).toString(),
    description: page.description
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: new URL(item.href, Astro.site).toString()
    }))
  },
  faqSchema(page)
].filter(Boolean);
const heading = page.intro.find((block) => block.kind === 'heading')?.text;
const introParagraphs = page.intro.filter((block) => block.kind === 'paragraph');
---

<BaseLayout title={page.title} description={page.description} image={service.image} schema={schema}>
  <section class="hero service-hero" style={`--hero-image: url('${service.image}')`}>
    <div class="container hero-copy">
      <Breadcrumb items={breadcrumbItems} />
      <div class="eyebrow">{service.title}</div>
      <h1>{heading}</h1>
      <div class="hero-description">
        {introParagraphs.map((block) => <p>{block.text}</p>)}
      </div>
      <div class="hero-actions"><a class="btn light" href="/contact/">Request a Free Assessment</a></div>
    </div>
  </section>
  <DocumentSections page={page} />
</BaseLayout>

<style>
  .service-hero { min-height: 68vh; padding: 118px 0 76px; }
  .hero-description { max-width: 720px; display: grid; gap: 10px; margin-top: 20px; }
  .hero-description p { margin: 0; line-height: 1.72; }
  @media (max-width: 520px) { .service-hero { min-height: auto; padding: 112px 0 64px; } }
</style>
