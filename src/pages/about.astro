---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CTASection from '@/components/CTASection.astro';
---

<BaseLayout title="About" description="Learn about Pro Surface Works, a Singapore flooring and surface restoration specialist focused on careful assessment, preparation, workmanship and quality finishing.">
  <section class="hero slim" style={`--hero-image: url('https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1800&q=80')`}>
    <div class="container hero-copy">
      <div class="eyebrow">About Pro Surface Works</div>
      <h1>Surface Restoration Built Around Quality</h1>
      <p>Professional surface restoration for floors, marble, timber, tiles, grout, finished surfaces and outdoor decking across Singapore.</p>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div>
        <div class="eyebrow">Who We Are</div>
        <h2>A professional flooring and surface restoration specialist.</h2>
      </div>
      <div>
        <p>Pro Surface Works supports residential and commercial clients with focused restoration, polishing, repair, preparation and finishing services. The work is centered on matching the right method to the actual surface condition.</p>
        <p>From marble and stone care to timber finishing, varnishing, staining, sanding, repairs, tiles, grout and outdoor decking, the goal is a cleaner, more refined surface that suits the property and use case.</p>
      </div>
    </div>
  </section>
  <section class="section dark">
    <div class="container">
      <SectionHeading eyebrow="Our Expertise" title="Complete surface care without a generic handyman feel." />
      <div class="grid four">
        {['Floor polishing', 'Marble & stone', 'Timber & wood', 'Varnishing', 'Staining', 'Sanding', 'Repairs', 'Tiles & grout', 'Outdoor decking'].map((item) => <div class="tile reveal">{item}</div>)}
      </div>
    </div>
  </section>
  <section class="section approach">
    <div class="container">
      <SectionHeading eyebrow="Our Approach" title="Careful assessment, proper preparation and professional workmanship." text="A strong finish starts before the visible work begins. Each project is handled through surface review, preparation, restoration and finishing." />
      <div class="grid three">
        {['Careful assessment', 'Proper preparation', 'Professional workmanship', 'Quality finishing', 'Customer-focused service', 'Clear communication'].map((item) => <article class="point reveal"><h3>{item}</h3><p>Practical project handling with attention to the condition, material and expected result.</p></article>)}
      </div>
    </div>
  </section>
  <CTASection />
</BaseLayout>

<style>
  .slim {
    min-height: 62vh;
  }

  .split {
    display: grid;
    grid-template-columns: 0.9fr 1fr;
    gap: 58px;
  }

  .tile,
  .point {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .dark .tile {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.45rem;
    font-weight: 700;
  }

  .approach {
    background: var(--white);
  }

  .point {
    background: var(--paper);
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
