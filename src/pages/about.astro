---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocumentSections from '@/components/DocumentSections.astro';
import { pageCopy, faqSchema } from '@/data/pageCopy';

const page = pageCopy.about;
const heroImage = 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1800&q=80';
const heading = page.intro.find((block) => block.kind === 'heading')?.text;
const lead = page.intro.find((block) => block.kind === 'paragraph')?.text;
---

<BaseLayout title={page.title} description={page.description} image={heroImage} schema={faqSchema(page)}>
  <section class="hero document-hero" style={`--hero-image: url('${heroImage}')`}>
    <div class="container hero-copy">
      <div class="eyebrow">Pro Surface Works</div>
      <h1>{heading}</h1>
      <p>{lead}</p>
    </div>
  </section>
  <section class="section intro-section">
    <div class="container intro-copy">
      {page.intro.filter((block) => block.kind === 'paragraph').slice(1).map((block) => <p>{block.text}</p>)}
    </div>
  </section>
  <DocumentSections page={page} />
</BaseLayout>

<style>
  .document-hero { min-height: 62vh; }
  .intro-section { background: var(--paper); }
  .intro-copy { max-width: 880px; }
</style>
