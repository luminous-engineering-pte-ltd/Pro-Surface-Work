---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocumentSections from '@/components/DocumentSections.astro';
import { pageCopy, faqSchema } from '@/data/pageCopy';

const page = pageCopy.about;
const heroImage = 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1800&q=80';
const heading = page.intro.find((block) => block.kind === 'heading')?.text;
const lead = page.intro.find((block) => block.kind === 'paragraph')?.text;
---

<BaseLayout title={page.title} description={page.description} image={heroImage} schema={faqSchema(page)}>
  <section class="hero document-hero" style={`--hero-image: url('${heroImage}')`}>
    <div class="container hero-copy">
      <div class="eyebrow">Pro Surface Works</div>
      <h1>{heading}</h1>
      <p>{lead}</p>
    </div>
  </section>
  <section class="section intro-section">
    <div class="container intro-copy">
      {page.intro.filter((block) => block.kind === 'paragraph').slice(1).map((block) => <p>{block.text}</p>)}
    </div>
  </section>
  <DocumentSections page={page} />
</BaseLayout>

<style>
  .document-hero { min-height: 62vh; }
  .intro-section {
    background:
      radial-gradient(circle at 12% 18%, rgba(37,99,235,.11), transparent 22rem),
      radial-gradient(circle at 88% 22%, rgba(124,58,237,.09), transparent 22rem),
      radial-gradient(circle at 54% 100%, rgba(6,182,212,.08), transparent 24rem),
      linear-gradient(180deg, #f4f8ff, #ffffff);
  }
  .intro-copy {
    position: relative;
    max-width: 920px;
    border: 1px solid rgba(16, 32, 51, 0.08);
    border-radius: 26px;
    padding: clamp(26px, 4vw, 44px);
    background: radial-gradient(circle at 100% 0%, rgba(37,99,235,.07), transparent 18rem), linear-gradient(180deg, rgba(255,255,255,.84), rgba(248,251,255,.7));
    box-shadow: 0 22px 60px rgba(7,21,37,.075), 0 0 0 1px rgba(255,255,255,.72) inset;
    backdrop-filter: blur(14px);
  }
  .intro-copy::after {
    position: absolute;
    left: clamp(24px, 4vw, 44px);
    right: clamp(24px, 4vw, 44px);
    bottom: 0;
    height: 4px;
    content: "";
    border-radius: 999px 999px 0 0;
    background: var(--accent-gradient);
    opacity: .7;
  }
</style>
