---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocumentSections from '@/components/DocumentSections.astro';
import DocumentCategoryGrid from '@/components/DocumentCategoryGrid.astro';
import { pageCopy, faqSchema } from '@/data/pageCopy';

const page = pageCopy.home;
const heroImage = 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2200&q=85';
const heading = page.intro.find((block) => block.kind === 'heading')?.text;
const lead = page.intro.find((block) => block.kind === 'paragraph')?.text;
---

<BaseLayout title={page.title} description={page.description} image={heroImage} schema={faqSchema(page)}>
  <section class="hero home-hero" style={`--hero-image: url('${heroImage}')`}>
    <div class="container hero-copy">
      <div class="eyebrow">{page.intro.find((block) => block.kind === 'eyebrow')?.text}</div>
      <h1>{heading}</h1>
      <p>{lead}</p>
      <div class="hero-actions">
        <a class="btn light" href="/contact/">Get a Free Quote</a>
        <a class="btn ghost" href="/services/">Explore Services</a>
      </div>
    </div>
  </section>
  <DocumentCategoryGrid page={page} sectionName="WHAT WE DO" />
  <DocumentSections page={page} skip={['WHAT WE DO']} />
</BaseLayout>
