---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { company, services } from '@/data/services';
---

<BaseLayout title="Floor Polishing Quote Singapore" description="Request a floor polishing quote in Singapore from Pro Surface Works for marble, parquet, grouting, timber, decking and vinyl flooring services.">
  <section class="hero slim" style={`--hero-image: url('https://images.unsplash.com/photo-1600566752355-35792bedcfea?auto=format&fit=crop&w=1800&q=80')`}>
    <div class="container hero-copy">
      <div class="eyebrow">Contact</div>
      <h1>Request a floor polishing quote in Singapore.</h1>
      <p>Share the surface type, current condition and photos so Pro Surface Works can recommend the right service.</p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <form class="contact-form" aria-label="Quote request form">
        <label>Full Name<input name="name" autocomplete="name" required /></label>
        <label>Email Address<input name="email" type="email" autocomplete="email" required /></label>
        <label>Phone / WhatsApp<input name="phone" autocomplete="tel" required /></label>
        <label>Property Type<select name="property"><option>Residential</option><option>Commercial</option><option>Other</option></select></label>
        <label>Surface Type<input name="surface" placeholder="Marble, parquet, tile, timber, vinyl..." /></label>
        <label>Service Required<select name="service">{services.map((service) => <option>{service.title}</option>)}</select></label>
        <label>Approximate Floor / Surface Area<input name="area" placeholder="e.g. 500 sq ft" /></label>
        <label>Preferred Date<input name="date" type="date" /></label>
        <label class="full">Message<textarea name="message" rows="6"></textarea></label>
        <button class="btn primary full" type="submit">Request a Free Quote</button>
      </form>
      <aside class="contact-info">
        <div class="eyebrow">Contact Information</div>
        <h2>Let's talk about your surface.</h2>
        <p>Photos are helpful for floor polishing, marble restoration, parquet repair, regrouting, wood repair, decking and vinyl flooring quote requests.</p>
        <a href={`mailto:${company.email}`}><span>Email</span>{company.email}</a>
        <a href={`https://wa.me/${company.whatsapp}`}><span>Phone / WhatsApp</span>{company.phone}</a>
        <a href={`https://${company.domain}`}><span>Website</span>{company.domain}</a>
        <a class="btn primary" href={`https://wa.me/${company.whatsapp}`}>WhatsApp for Quote</a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .slim { min-height: 62vh; align-items: center; padding: 118px 0 90px; }
  .section {
    background:
      radial-gradient(circle at 14% 10%, rgba(37,99,235,.12), transparent 22rem),
      radial-gradient(circle at 88% 22%, rgba(124,58,237,.1), transparent 22rem),
      radial-gradient(circle at 50% 100%, rgba(6,182,212,.09), transparent 24rem),
      linear-gradient(180deg, #f4f8ff, #ffffff);
  }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr); gap: 34px; align-items: start; }
  .contact-form, .contact-info { border: 1px solid rgba(16, 32, 51, 0.1); border-radius: 24px; background: radial-gradient(circle at 100% 0%, rgba(37,99,235,.07), transparent 18rem), linear-gradient(180deg, rgba(255,255,255,.9), rgba(247,250,255,.76)); box-shadow: 0 24px 68px rgba(7, 21, 37, 0.11), 0 0 0 1px rgba(255,255,255,.74) inset; backdrop-filter: blur(14px); }
  .contact-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; padding: 32px; }
  label { display: grid; gap: 8px; color: var(--ink); font-weight: 850; transition: color 180ms ease, transform 220ms var(--ease-premium); }
  label:focus-within { transform: translateY(-1px); }
  input, select, textarea { width: 100%; border: 1px solid rgba(37, 99, 235, 0.12); border-radius: 12px; padding: 14px; color: var(--ink); background: rgba(255, 255, 255, .68); }
  textarea { resize: vertical; }
  .full { grid-column: 1 / -1; }
  .contact-info { position: sticky; top: 104px; padding: 36px; overflow: hidden; }
  .contact-info::before { position: absolute; right: -42px; top: -42px; width: 140px; height: 140px; content: ""; border-radius: 50%; background: radial-gradient(circle, rgba(37,99,235,.2), transparent 68%); pointer-events: none; }
  .contact-info::after { position: absolute; left: 36px; right: 36px; bottom: 0; height: 4px; content: ""; border-radius: 999px 999px 0 0; background: var(--accent-gradient); opacity: .74; }
  .contact-info a:not(.btn) { display: block; margin: 22px 0; font-weight: 900; }
  .contact-info a:not(.btn):hover { color: #1d4ed8; transform: translateX(3px); }
  .contact-info span { display: block; color: var(--muted); font-size: 0.82rem; text-transform: uppercase; }
  @media (max-width: 900px) {
    .slim { min-height: 58vh; padding: 112px 0 76px; }
    .contact-grid, .contact-form { grid-template-columns: 1fr; }
    .contact-info { position: relative; top: auto; }
  }
  @media (max-width: 520px) {
    .slim { min-height: auto; padding: 112px 0 64px; }
  }
</style>

