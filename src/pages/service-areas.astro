---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CTASection from '@/components/CTASection.astro';

const areas = ['Central Singapore', 'East Singapore', 'West Singapore', 'North Singapore', 'North-East Singapore', 'CBD and commercial districts', 'Condominiums and apartments', 'Landed homes'];
---

<BaseLayout title="Floor Polishing Services Singapore Islandwide" description="Pro Surface Works provides floor polishing and restoration services islandwide across Singapore for homes and commercial spaces.">
  <section class="hero slim" style={`--hero-image: url('https://images.unsplash.com/photo-1525625293386-3f8f99389edd?auto=format&fit=crop&w=1800&q=80')`}>
    <div class="container hero-copy">
      <div class="eyebrow">Service Areas</div>
      <h1>Floor polishing services Singapore islandwide.</h1>
      <p>Islandwide support for floor restoration, marble polishing, parquet repair, grouting, timber repair, decking and vinyl flooring services.</p>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div>
        <div class="eyebrow">Singapore Coverage</div>
        <h2>Homes and commercial spaces across the island.</h2>
      </div>
      <p>Pro Surface Works serves Singapore customers who need reliable floor and surface care without navigating duplicate or confusing service pages. Share your location, photos and preferred timing for practical quote support.</p>
    </div>
  </section>
  <section class="section dark">
    <div class="container">
      <SectionHeading eyebrow="Coverage" title="Common property and area types." />
      <div class="grid four">
        {areas.map((area) => <article class="area reveal"><h3>{area}</h3></article>)}
      </div>
    </div>
  </section>
  <CTASection />
</BaseLayout>

<style>
  .slim { min-height: 62vh; }
  .split { display: grid; grid-template-columns: 0.9fr 1fr; gap: 58px; }
  .area { padding: 24px; border: 1px solid rgba(255, 255, 255, 0.16); border-radius: var(--radius); }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
</style>
