---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocumentSections from '@/components/DocumentSections.astro';
import { faqSchema, type CopyBlock, type CopyPage } from '@/data/pageCopy';
import content from '@/data/service-areas-content.json';

const heroImage = 'https://images.unsplash.com/photo-1525625293386-3f8f99389edd?auto=format&fit=crop&w=1800&q=80';
const pairedSections = new Set([
  'Areas We Serve',
  'How Our Singapore-Wide Service Works',
  'Frequently Asked Questions'
]);
const listSections = new Set([
  'Our Flooring & Surface Services Across Singapore',
  'Why Local Coverage Matters for Floor & Surface Work',
  'Why Customers Choose Professional Floor & Surface Care'
]);

const page: CopyPage = {
  url: content.url,
  title: content.title,
  description: content.description,
  intro: [
    { kind: 'heading', text: content.heading },
    { kind: 'paragraph', text: content.lead }
  ],
  sections: content.sections.map((section) => {
    const blocks: CopyBlock[] = section.blocks.map((block, index) => {
      if (section.title === 'Need Floor or Surface Care in Singapore?' && index === 1) return { kind: 'link', text: block.text };
      if (section.title === 'Properties We Serve') {
        return { kind: block.style === 'ListParagraph' ? 'list' : 'heading', text: block.text };
      }
      if (pairedSections.has(section.title) && index % 2 === 0 && !(section.title === 'Areas We Serve' && index === section.blocks.length - 1)) {
        return { kind: 'heading', text: block.text };
      }
      if (listSections.has(section.title)) return { kind: 'list', text: block.text };
      return { kind: 'paragraph', text: block.text };
    });
    return {
      eyebrow: section.title === 'Frequently Asked Questions' ? 'FAQ' : '',
      title: section.title,
      blocks
    };
  })
};
---

<BaseLayout title={page.title} description={page.description} image={heroImage} schema={faqSchema(page)}>
  <section class="hero slim" style={`--hero-image: url('${heroImage}')`}>
    <div class="container hero-copy">
      <div class="eyebrow">Service Areas</div>
      <h1>{content.heading}</h1>
      <p>{content.lead}</p>
      <div class="hero-actions"><a class="btn light" href="/contact/">{content.ctaLabel}</a></div>
    </div>
  </section>
  <DocumentSections page={page} />
</BaseLayout>

<style>
  .slim { min-height: 62vh; }
</style>
