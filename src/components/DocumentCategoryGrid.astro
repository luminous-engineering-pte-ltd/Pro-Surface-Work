---
import { services, servicePath, subServicePath } from '@/data/services';
import { type CopyPage } from '@/data/pageCopy';

type Props = { page: CopyPage; sectionName: string; showChildren?: boolean };
const { page, sectionName, showChildren = false } = Astro.props;
const section = page.sections.find((item) => item.eyebrow === sectionName);
const blocks = section?.blocks ?? [];
const introduction = blocks[0]?.kind === 'paragraph' ? blocks[0].text : undefined;
const categories = services.map((service) => {
  const index = blocks.findIndex((block) => block.kind === 'heading' && block.text === service.title);
  const description = index >= 0 && blocks[index + 1]?.kind === 'paragraph' ? blocks[index + 1].text : service.summary;
  return { service, description };
});
---

{section && (
  <section class="section category-section">
    <div class="container">
      <div class="section-intro">
        <div class="eyebrow">{section.eyebrow}</div>
        <h2>{section.title}</h2>
        {introduction && <p>{introduction}</p>}
      </div>
      <div class:list={['category-grid', { expanded: showChildren }]}>
        {categories.map(({ service, description }) => (
          <article class="category-card">
            <a class="category-media" href={servicePath(service)} aria-label={`Explore ${service.title}`}>
              <img src={service.image} alt={`${service.title} service by Pro Surface Works`} loading="lazy" />
              <span class="category-number">{service.number}</span>
            </a>
            <div class="category-content">
              <h3><a href={servicePath(service)}>{service.title}</a></h3>
              <p>{description}</p>
              {showChildren && service.subServices.length > 0 && (
                <ul>{service.subServices.map((child) => <li><a href={subServicePath(service, child)}>{child.title}</a></li>)}</ul>
              )}
              <a class="category-more" href={servicePath(service)}>Explore {service.title} <span aria-hidden="true">&rarr;</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .category-section {
    background:
      radial-gradient(circle at 12% 14%, rgba(37,99,235,.14), transparent 24rem),
      radial-gradient(circle at 88% 6%, rgba(124,58,237,.13), transparent 22rem),
      radial-gradient(circle at 46% 54%, rgba(6,182,212,.08), transparent 28rem),
      radial-gradient(circle at 52% 100%, rgba(183,155,99,.1), transparent 28rem),
      linear-gradient(180deg, #ffffff 0%, #f1f7ff 100%);
  }
  .category-section::before {
    background-image:
      radial-gradient(circle, rgba(47,111,174,.18) 1px, transparent 1px),
      linear-gradient(rgba(31,90,73,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(31,90,73,.045) 1px, transparent 1px);
    background-size: 22px 22px, 56px 56px, 56px 56px;
    mask-image: radial-gradient(circle at 50% 20%, #000, transparent 38rem);
    opacity: .5;
  }
  .category-section::after {
    position: absolute;
    left: 50%;
    top: 42px;
    width: min(1180px, calc(100% - 40px));
    height: calc(100% - 84px);
    content: "";
    border: 1px solid rgba(16, 32, 51, 0.06);
    border-radius: 32px;
    background:
      linear-gradient(135deg, rgba(255,255,255,.64), rgba(255,255,255,.28));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.86), 0 24px 70px rgba(47,111,174,.08);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .section-intro { max-width: 820px; margin-bottom: 42px; }
  .section-intro h2 { margin: 8px 0 16px; font-size: clamp(2rem, 3.5vw, 3.35rem); line-height: 1.05; }
  .category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; align-items: stretch; }
  .category-grid.expanded { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .category-card { --card-a: #2563eb; --card-b: #06b6d4; position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 100%; padding: 12px; border: 1px solid rgba(16, 32, 51, 0.1); border-radius: 22px; background: linear-gradient(180deg, rgba(255,255,255,.95), rgba(247,250,255,.9)); overflow: hidden; isolation: isolate; box-shadow: 0 20px 54px rgba(7, 21, 37, 0.09), 0 0 0 1px rgba(255,255,255,.72) inset; }
  .category-card:nth-child(2) { --card-a: #0d9488; --card-b: #2563eb; }
  .category-card:nth-child(3) { --card-a: #7c3aed; --card-b: #06b6d4; }
  .category-card:nth-child(4) { --card-a: #0891b2; --card-b: #b79b63; }
  .category-card:nth-child(5) { --card-a: #2b8a7e; --card-b: #7c3aed; }
  .category-card:nth-child(6) { --card-a: #2563eb; --card-b: #b79b63; }
  .category-card:nth-child(7) { --card-a: #0ea5e9; --card-b: #2b8a7e; }
  .category-card::before { position: absolute; inset: 0; z-index: -1; padding: 1px; border-radius: inherit; content: ""; opacity: .78; background: linear-gradient(135deg, color-mix(in srgb, var(--card-a) 42%, transparent), rgba(255,255,255,.08) 38%, color-mix(in srgb, var(--card-b) 38%, transparent)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude; pointer-events: none; transition: opacity 420ms ease; }
  .category-card::after { position: absolute; inset: auto 18px 0; height: 4px; content: ""; border-radius: 999px 999px 0 0; background: linear-gradient(90deg, var(--card-a), var(--card-b)); opacity: .68; transform: scaleX(.32); transform-origin: left; transition: transform 520ms var(--ease-premium), opacity 420ms ease; }
  .category-card:hover::before { opacity: 1; }
  .category-card:hover::after { opacity: .9; transform: scaleX(1); }
  .category-media { position: relative; display: block; margin: 0; border-radius: 14px; overflow: hidden; aspect-ratio: 16 / 10; background: var(--navy); }
  .category-media::after { position: absolute; inset: 0; content: ""; background: linear-gradient(180deg, transparent 34%, rgba(7,21,37,.54)); opacity: .74; transition: opacity 520ms ease; }
  .category-media img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.01); transition: transform 820ms var(--ease-premium), filter 520ms ease; }
  .category-card:hover .category-media img { transform: scale(1.075); filter: saturate(1.04) contrast(1.04); }
  .category-card:hover .category-media::after { opacity: .58; }
  .category-number { position: absolute; left: 14px; bottom: 14px; z-index: 1; display: inline-grid; width: 44px; height: 44px; place-items: center; border: 1px solid rgba(255,255,255,.42); border-radius: 50%; color: var(--white); background: linear-gradient(135deg, var(--card-a), var(--card-b)); box-shadow: 0 10px 28px color-mix(in srgb, var(--card-a) 28%, transparent); font-size: .86rem; font-weight: 900; backdrop-filter: blur(12px); transition: transform 420ms var(--ease-premium), box-shadow 420ms ease; }
  .category-card:hover .category-number { transform: translateY(-3px) rotate(-6deg); }
  .category-content { display: flex; flex: 1; flex-direction: column; padding: 22px 8px 8px; }
  .category-card h3 { margin: 0 0 12px; font-size: clamp(1.55rem, 2.3vw, 2rem); line-height: 1.03; }
  .category-card h3 a:hover, .category-card li a:hover { color: var(--green-2); }
  .category-card p { margin-bottom: 22px; font-size: .98rem; line-height: 1.68; }
  .category-card ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 18px; margin: 0 0 24px; padding: 0; list-style: none; font-size: 0.9rem; }
  .category-card li { min-width: 0; overflow-wrap: anywhere; }
  .category-more { display: inline-flex; align-items: center; justify-content: space-between; gap: 12px; width: fit-content; max-width: 100%; margin-top: auto; border: 1px solid color-mix(in srgb, var(--card-a) 20%, transparent); border-radius: 999px; padding: 10px 13px 10px 15px; color: color-mix(in srgb, var(--card-a) 82%, var(--green)); background: color-mix(in srgb, var(--card-a) 8%, transparent); font-size: .9rem; font-weight: 900; box-shadow: 0 10px 24px rgba(7,21,37,.04); }
  .category-more:hover, .category-more:focus-visible { color: var(--white); border-color: transparent; background: linear-gradient(135deg, var(--card-a), var(--card-b)); box-shadow: 0 12px 26px color-mix(in srgb, var(--card-a) 22%, transparent); }
  .category-more span { margin-left: 0; transition: transform 340ms var(--ease-premium); }
  .category-card:hover .category-more span { transform: translateX(4px); }
  @media (max-width: 900px) { .category-grid, .category-grid.expanded { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) {
    .category-grid, .category-grid.expanded, .category-card ul { grid-template-columns: 1fr; }
    .category-grid { gap: 18px; }
    .category-card { border-radius: 16px; padding: 10px; }
    .category-content { padding: 18px 6px 6px; }
    .category-media { aspect-ratio: 16 / 9; }
  }
</style>

