---
import { services, servicePath, subServicePath } from '@/data/services';
import { type CopyPage } from '@/data/pageCopy';

type Props = { page: CopyPage; sectionName: string; showChildren?: boolean };
const { page, sectionName, showChildren = false } = Astro.props;
const section = page.sections.find((item) => item.eyebrow === sectionName);
const blocks = section?.blocks ?? [];
const introduction = blocks[0]?.kind === 'paragraph' ? blocks[0].text : undefined;
const categories = services.map((service) => {
  const index = blocks.findIndex((block) => block.kind === 'heading' && block.text === service.title);
  const description = index >= 0 && blocks[index + 1]?.kind === 'paragraph' ? blocks[index + 1].text : service.summary;
  return { service, description };
});
---

{section && (
  <section class="section category-section">
    <div class="container">
      <div class="section-intro">
        <div class="eyebrow">{section.eyebrow}</div>
        <h2>{section.title}</h2>
        {introduction && <p>{introduction}</p>}
      </div>
      <div class:list={['category-grid', { expanded: showChildren }]}>
        {categories.map(({ service, description }) => (
          <article class="category-card">
            <span class="category-number">{service.number}</span>
            <h3><a href={servicePath(service)}>{service.title}</a></h3>
            <p>{description}</p>
            {showChildren && service.subServices.length > 0 && (
              <ul>{service.subServices.map((child) => <li><a href={subServicePath(service, child)}>{child.title}</a></li>)}</ul>
            )}
            <a class="category-more" href={servicePath(service)}>Explore {service.title} <span aria-hidden="true">&rarr;</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .category-section { background: var(--white); }
  .section-intro { max-width: 820px; margin-bottom: 36px; }
  .section-intro h2 { margin: 8px 0 16px; font-size: clamp(2rem, 3.5vw, 3.35rem); line-height: 1.05; }
  .category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .category-grid.expanded { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .category-card { display: flex; flex-direction: column; min-width: 0; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); }
  .category-number { color: var(--gold); font-weight: 900; }
  .category-card h3 { margin: 15px 0 10px; font-size: 1.85rem; }
  .category-card h3 a:hover, .category-card li a:hover { color: var(--green-2); }
  .category-card p { margin-bottom: 20px; }
  .category-card ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 18px; margin: 0 0 24px; padding: 0; list-style: none; font-size: 0.9rem; }
  .category-card li { min-width: 0; overflow-wrap: anywhere; }
  .category-more { margin-top: auto; color: var(--green-2); font-weight: 800; }
  .category-more span { margin-left: 4px; }
  @media (max-width: 900px) { .category-grid, .category-grid.expanded { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) { .category-grid, .category-grid.expanded, .category-card ul { grid-template-columns: 1fr; } }
</style>
