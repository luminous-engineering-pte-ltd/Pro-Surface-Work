---
import { company, footerQuickLinks, services, servicePath } from '@/data/services';

const mapUrl = 'https://maps.app.goo.gl/uhdDV3wg1tBqHB6R8';
const mapEmbedUrl = 'https://www.google.com/maps?q=Pro%20Surface%20Works%2C%2014%20Roberts%20Ln%2C%20Singapore%20218293&ll=1.3105546,103.8537588&z=17&output=embed';
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href="/" aria-label="Pro Surface Works home">
        <img class="brand-logo" src="/update-Pro.png" alt="Pro Surface Works" width="1774" height="887" />
        <span class="brand-text">Pro Surface Works</span>
      </a>
      <p>Professional floor polishing, restoration, timber finishing, marble care, grouting and surface solutions across Singapore.</p>
      <a class="btn light" href="/contact/">Get a Free Quote</a>
    </div>
    <div>
      <h3>Quick Links</h3>
      {footerQuickLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <div>
      <h3>Services</h3>
      {services.map((service) => <a href={servicePath(service)}>{service.title}</a>)}
    </div>
    <div>
      <h3>Contact</h3>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={`https://wa.me/${company.whatsapp}`}>{company.phone}</a>
      <span>{company.location}</span>
      <span>{company.address}</span>
      <div class="social-links" aria-label="Social media">
        <a class="social-icon" href="https://www.facebook.com/prosurfaceworks" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 8.45V6.9c0-.74.5-.91.85-.91h2.18V2.13L14.02 2.1c-3.34 0-4.1 2.5-4.1 4.1v2.25H7.27v3.98h2.65V22h4.08v-9.57h3.03l.4-3.98H14Z" />
          </svg>
        </a>
        <a class="social-icon" href="https://www.instagram.com/prosurfaceworks01" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.75 3.75 0 0 0 4 7.75v8.5A3.75 3.75 0 0 0 7.75 20h8.5A3.75 3.75 0 0 0 20 16.25v-8.5A3.75 3.75 0 0 0 16.25 4h-8.5Zm8.75 2.2a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 7.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 2a2.9 2.9 0 1 0 0 5.8 2.9 2.9 0 0 0 0-5.8Z" />
          </svg>
        </a>
        <a class="social-icon" href="https://www.tiktok.com/@prosurfaceworks" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M16.6 2c.33 2.85 1.92 4.55 4.65 4.73v3.2a8.1 8.1 0 0 1-4.6-1.4v6.85c0 3.46-2.12 6.62-6.5 6.62a6.45 6.45 0 0 1-6.4-6.52c0-4.08 3.16-6.86 7.15-6.38v3.34c-1.8-.28-3.8.84-3.8 3.04a3.02 3.02 0 0 0 3.08 3.07c2.06 0 3.1-1.38 3.1-3.4V2h3.32Z" />
          </svg>
        </a>
        <a class="social-icon" href="https://www.quora.com/profile/Pro-Surface-Works" target="_blank" rel="noopener noreferrer" aria-label="Quora">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.73 19.64c-.78.8-1.9 1.29-3.1 1.29-1.68 0-2.88-.73-3.77-1.74A8.8 8.8 0 0 1 11.46 20C6.4 20 2.8 16.34 2.8 11.47 2.8 6.5 6.5 2.8 11.6 2.8c5.04 0 8.66 3.64 8.66 8.5 0 2.3-.8 4.3-2.14 5.78.35.48.74.73 1.24.73.4 0 .75-.14 1.06-.42l.31 2.25ZM13 16.34c-.53-1.02-1.13-1.72-2.07-1.72-.42 0-.8.12-1.14.33l-.56-2.28c.68-.42 1.45-.63 2.27-.63 1.7 0 2.72.95 3.65 2.42.45-.84.7-1.9.7-3.08 0-3.29-1.68-5.58-4.28-5.58-2.63 0-4.33 2.3-4.33 5.62 0 3.25 1.69 5.57 4.3 5.57.51 0 1-.09 1.46-.25v-.4Z" />
          </svg>
        </a>
        <a class="social-icon" href="https://www.reddit.com/user/prosurfaceworks/" target="_blank" rel="noopener noreferrer" aria-label="Reddit">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 11.85a2.32 2.32 0 0 0-3.94-1.66 11.44 11.44 0 0 0-5.16-1.47l.88-4.12 2.86.61a1.74 1.74 0 1 0 .22-1.05l-3.42-.73a.54.54 0 0 0-.64.42l-1.04 4.88a11.56 11.56 0 0 0-5.82 1.47 2.32 2.32 0 1 0-2.55 3.77 4.42 4.42 0 0 0-.07.75c0 3.31 3.9 6 8.7 6s8.7-2.69 8.7-6c0-.25-.02-.5-.07-.74A2.32 2.32 0 0 0 22 11.85ZM8.05 13.7a1.54 1.54 0 1 1 3.08 0 1.54 1.54 0 0 1-3.08 0Zm7.59 3.9c-.74.74-2.16 1.1-3.64 1.1s-2.9-.36-3.64-1.1a.54.54 0 0 1 .76-.76c.47.47 1.58.79 2.88.79s2.41-.32 2.88-.79a.54.54 0 0 1 .76.76Zm.27-2.36a1.54 1.54 0 1 1 0-3.08 1.54 1.54 0 0 1 0 3.08Z" />
          </svg>
        </a>
        <a class="social-icon" href="https://youtube.com/@prosurfaceworks?si=tCMJ_y5vIFVgvFKc" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21.58 7.19a2.74 2.74 0 0 0-1.93-1.94C17.94 4.8 12 4.8 12 4.8s-5.94 0-7.65.45a2.74 2.74 0 0 0-1.93 1.94A28.6 28.6 0 0 0 2 12a28.6 28.6 0 0 0 .42 4.81 2.74 2.74 0 0 0 1.93 1.94c1.71.45 7.65.45 7.65.45s5.94 0 7.65-.45a2.74 2.74 0 0 0 1.93-1.94A28.6 28.6 0 0 0 22 12a28.6 28.6 0 0 0-.42-4.81ZM10 15.25v-6.5L15.2 12 10 15.25Z" />
          </svg>
        </a>
        <a class="social-icon" href="https://x.com/ProSurfaceWorks" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13.86 10.47 21.12 2h-1.72l-6.31 7.35L8.06 2H2.25l7.61 11.11L2.25 22h1.72l6.65-7.76L15.94 22h5.81l-7.89-11.53Zm-2.35 2.74-.77-1.1L4.61 3.3h2.63l4.95 7.1.77 1.1 6.44 9.25h-2.63l-5.26-7.54Z" />
          </svg>
        </a>
        <a class="social-icon" href="https://www.linkedin.com/company/pro-surface-works" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.94 8.98H3.2V21h3.74V8.98ZM5.07 3a2.17 2.17 0 1 0 0 4.34A2.17 2.17 0 0 0 5.07 3Zm15.73 11.1c0-3.23-1.72-5.42-4.55-5.42-2.1 0-3.04 1.15-3.56 1.96V8.98H9.11V21h3.73v-5.95c0-1.57.3-3.1 2.25-3.1 1.92 0 1.95 1.8 1.95 3.2V21h3.76v-6.9Z" />
          </svg>
        </a>
        <a class="social-icon" href="https://bsky.app/profile/prosurfaceworks.bsky.social" target="_blank" rel="noopener noreferrer" aria-label="BlueSky">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5.84 4.42C8.33 6.28 11 10.05 12 12.08c1-2.03 3.67-5.8 6.16-7.66 1.79-1.34 4.69-2.38 4.69.92 0 .66-.38 5.55-.6 6.34-.77 2.74-3.58 3.44-6.08 3.02 4.37.74 5.48 3.2 3.08 5.67-4.55 4.68-6.54-1.17-7.05-2.67-.09-.27-.14-.4-.2-.4s-.11.13-.2.4c-.51 1.5-2.5 7.35-7.05 2.67-2.4-2.47-1.29-4.93 3.08-5.67-2.5.42-5.31-.28-6.08-3.02-.22-.79-.6-5.68-.6-6.34 0-3.3 2.9-2.26 4.69-.92Z" />
          </svg>
        </a>
        <a class="trustpilot-link" href="https://www.trustpilot.com/review/prosurfaceworks.com" target="_blank" rel="noopener noreferrer" aria-label="Review Pro Surface Works on Trustpilot">
          <span class="trustpilot-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="m12 2 2.42 6.44 6.88.3-5.38 4.3 1.83 6.64L12 15.9l-5.75 3.78 1.83-6.64-5.38-4.3 6.88-.3L12 2Z" />
            </svg>
          </span>
          <span>Trustpilot</span>
        </a>
      </div>
    </div>
    <div class="footer-map">
      <h3>Our Location</h3>
      <a class="map-link" href={mapUrl} target="_blank" rel="noopener noreferrer" aria-label="Open Pro Surface Works location in Google Maps">
        <iframe
          src={mapEmbedUrl}
          title="Pro Surface Works location on Google Maps"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          aria-hidden="true"
        ></iframe>
        <span class="map-place-card" aria-hidden="true">
          <strong>Pro Surface Works</strong>
          <span>14 Roberts Ln, Singapore</span>
          <span class="map-rating"><b>5.0</b><span class="map-stars">★★★★★</span><em>Reviews</em></span>
        </span>
      </a>
    </div>
  </div>
  <div class="container footer-bottom">&copy; 2026 Pro Surface Works. All rights reserved.</div>
</footer>

<style>
  .footer {
    position: relative;
    color: var(--white);
    background:
      radial-gradient(circle at 18% 0%, rgba(43, 138, 126, 0.14), transparent 26rem),
      radial-gradient(circle at 82% 8%, rgba(183, 155, 99, 0.12), transparent 24rem),
      var(--navy);
    padding: 72px 0 24px;
    overflow: hidden;
  }

  .footer::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    content: "";
    background: linear-gradient(90deg, transparent, rgba(183,155,99,.42), rgba(43,138,126,.32), transparent);
  }

  .footer > .container {
    width: 85%;
    max-width: 1600px;
    margin-inline: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns:
      minmax(250px, 1.2fr)
      minmax(140px, 0.68fr)
      minmax(190px, 0.92fr)
      minmax(200px, 0.95fr)
      minmax(260px, 1.08fr);
    gap: clamp(32px, 2.7vw, 48px);
    align-items: start;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--white);
    margin-bottom: 20px;
  }

  .brand-logo {
    width: 126px;
    height: 70px;
    flex: 0 0 auto;
    object-fit: contain;
    object-position: center;
  }

  .brand-text {
    color: var(--white);
    font-size: 1.22rem;
    font-weight: 900;
    line-height: 1.05;
    white-space: nowrap;
  }

  h3 {
    margin-bottom: 16px;
    font-size: 1.25rem;
  }

  a,
  span {
    display: block;
    color: rgba(255, 255, 255, 0.74);
    margin-bottom: 10px;
    overflow-wrap: anywhere;
  }

  p {
    max-width: 390px;
    color: rgba(255, 255, 255, 0.72);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin: 0;
    color: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .social-icon svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .social-icon:hover,
  .social-icon:focus-visible {
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.13);
    box-shadow: 0 12px 26px rgba(183, 155, 99, 0.16);
    transform: translateY(-3px) scale(1.07);
  }

  .trustpilot-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    border: 1px solid rgba(0, 182, 122, 0.34);
    border-radius: 999px;
    padding: 0 12px 0 7px;
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
    background:
      linear-gradient(135deg, rgba(0, 182, 122, 0.16), rgba(255, 255, 255, 0.06));
    box-shadow:
      0 12px 26px rgba(0, 0, 0, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    font-size: 0.94rem;
    font-weight: 800;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 220ms var(--ease-premium),
      transform 220ms var(--ease-premium);
  }

  .trustpilot-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    margin: 0;
    color: var(--white);
    background: #00b67a;
    box-shadow: 0 8px 18px rgba(0, 182, 122, 0.26);
  }

  .trustpilot-mark svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .trustpilot-link > span {
    display: inline-flex;
    align-items: center;
    margin: 0;
    color: inherit;
    line-height: 1;
  }

  .trustpilot-link:hover,
  .trustpilot-link:focus-visible {
    color: var(--white);
    border-color: rgba(0, 182, 122, 0.68);
    background:
      linear-gradient(135deg, rgba(0, 182, 122, 0.24), rgba(255, 255, 255, 0.1));
    box-shadow:
      0 16px 34px rgba(0, 0, 0, 0.18),
      0 0 28px rgba(0, 182, 122, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transform: translateY(-3px) scale(1.03);
  }

  .footer-map {
    min-width: 0;
    width: fit-content;
  }

  .map-link {
    position: relative;
    display: block;
    width: clamp(160px, 11vw, 180px);
    height: clamp(150px, 10vw, 170px);
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.22);
    cursor: pointer;
    isolation: isolate;
    transition:
      border-color 320ms ease,
      box-shadow 360ms var(--ease-premium),
      transform 360ms var(--ease-premium);
  }

  .map-link::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(7, 21, 37, 0.04), rgba(7, 21, 37, 0.24)),
      radial-gradient(circle at 18% 14%, rgba(183, 155, 99, 0.22), transparent 14rem);
    opacity: 0.58;
    transition: opacity 320ms ease;
  }

  .map-link iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    filter: saturate(0.9) contrast(1.02);
    pointer-events: none;
    transform: scale(1.01);
    transform-origin: center;
    transition: transform 520ms var(--ease-premium), filter 360ms ease;
  }

  .map-place-card {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    z-index: 2;
    display: grid;
    gap: 2px;
    max-width: 142px;
    border: 1px solid rgba(7, 21, 37, 0.08);
    border-radius: 9px;
    padding: 7px 8px;
    margin: 0;
    color: #1f2937;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 10px 24px rgba(7, 21, 37, 0.2);
    font-family: Arial, sans-serif;
    line-height: 1.1;
    pointer-events: none;
  }

  .map-place-card strong,
  .map-place-card span,
  .map-place-card b,
  .map-place-card em {
    display: inline;
    margin: 0;
    color: inherit;
    overflow-wrap: normal;
  }

  .map-place-card strong {
    display: block;
    color: #1f2937;
    font-size: 0.69rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .map-place-card > span {
    display: block;
    color: #5f6368;
    font-size: 0.57rem;
  }

  .map-rating {
    display: flex !important;
    align-items: center;
    gap: 3px;
    color: #5f6368 !important;
    font-size: 0.58rem !important;
    white-space: nowrap;
  }

  .map-rating b {
    color: #3c4043;
    font-weight: 700;
  }

  .map-stars {
    color: #f59e0b !important;
    font-size: 0.62rem;
    letter-spacing: -0.03em;
  }

  .map-rating em {
    color: #2563eb;
    font-style: normal;
    font-weight: 700;
  }

  .map-link:hover,
  .map-link:focus-visible {
    border-color: rgba(255, 255, 255, 0.32);
    box-shadow: 0 24px 58px rgba(0, 0, 0, 0.3);
    transform: translateY(-3px) scale(1.01);
  }

  .map-link:hover::before,
  .map-link:focus-visible::before {
    opacity: 0.42;
  }

  .map-link:hover iframe,
  .map-link:focus-visible iframe {
    filter: saturate(1) contrast(1.04);
    transform: scale(1.045);
  }

  .footer-bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.92rem;
  }

  @media (max-width: 1500px) {
    .footer-grid {
      grid-template-columns: minmax(260px, 1.1fr) minmax(160px, 0.8fr) minmax(220px, 1fr);
    }

    .footer-map {
      grid-column: span 2;
    }

    .map-link {
      width: clamp(160px, 12vw, 180px);
    }
  }

  @media (max-width: 1120px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-map {
      grid-column: 1 / -1;
      width: 100%;
      justify-self: center;
      text-align: center;
    }

    .map-link {
      width: clamp(190px, 34vw, 240px);
      height: clamp(170px, 28vw, 200px);
      margin-inline: auto;
    }
  }

  @media (max-width: 900px) {
    .footer > .container {
      width: calc(100% - 40px);
      max-width: 680px;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .footer-map {
      grid-column: auto;
      width: fit-content;
      justify-self: start;
      text-align: left;
    }

    .map-link {
      width: 160px;
      height: 145px;
      margin-inline: 0;
    }
  }

  @media (max-width: 520px) {
    .footer > .container {
      width: calc(100% - 28px);
    }

    .brand {
      gap: 10px;
    }

    .brand-logo {
      width: 104px;
      height: 58px;
    }

    .brand-text {
      font-size: 1.05rem;
    }
  }
</style>
