---
import { company, footerQuickLinks, services, servicePath } from '@/data/services';
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href="/" aria-label="Pro Surface Works home">
        <img class="brand-logo" src="/update-Pro.png" alt="Pro Surface Works" width="1774" height="887" />
        <span class="brand-text">Pro Surface Works</span>
      </a>
      <p>Professional floor polishing, restoration, timber finishing, marble care, grouting and surface solutions across Singapore.</p>
      <a class="btn light" href="/contact/">Get a Free Quote</a>
    </div>
    <div>
      <h3>Quick Links</h3>
      {footerQuickLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <div>
      <h3>Services</h3>
      {services.map((service) => <a href={servicePath(service)}>{service.title}</a>)}
    </div>
    <div>
      <h3>Contact</h3>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={`https://wa.me/${company.whatsapp}`}>{company.phone}</a>
      <span>{company.location}</span>
      <span>{company.address}</span>
      <div class="social-links" aria-label="Social media">
        <span class="social-icon" role="img" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 8.45V6.9c0-.74.5-.91.85-.91h2.18V2.13L14.02 2.1c-3.34 0-4.1 2.5-4.1 4.1v2.25H7.27v3.98h2.65V22h4.08v-9.57h3.03l.4-3.98H14Z" />
          </svg>
        </span>
        <span class="social-icon" role="img" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7.75 2h8.5A5.76 5.76 0 0 1 22 7.75v8.5A5.76 5.76 0 0 1 16.25 22h-8.5A5.76 5.76 0 0 1 2 16.25v-8.5A5.76 5.76 0 0 1 7.75 2Zm0 2A3.75 3.75 0 0 0 4 7.75v8.5A3.75 3.75 0 0 0 7.75 20h8.5A3.75 3.75 0 0 0 20 16.25v-8.5A3.75 3.75 0 0 0 16.25 4h-8.5Zm8.75 2.2a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 7.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 2a2.9 2.9 0 1 0 0 5.8 2.9 2.9 0 0 0 0-5.8Z" />
          </svg>
        </span>
        <a class="social-icon" href="https://youtube.com/@prosurfaceworks?si=tCMJ_y5vIFVgvFKc" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21.58 7.19a2.74 2.74 0 0 0-1.93-1.94C17.94 4.8 12 4.8 12 4.8s-5.94 0-7.65.45a2.74 2.74 0 0 0-1.93 1.94A28.6 28.6 0 0 0 2 12a28.6 28.6 0 0 0 .42 4.81 2.74 2.74 0 0 0 1.93 1.94c1.71.45 7.65.45 7.65.45s5.94 0 7.65-.45a2.74 2.74 0 0 0 1.93-1.94A28.6 28.6 0 0 0 22 12a28.6 28.6 0 0 0-.42-4.81ZM10 15.25v-6.5L15.2 12 10 15.25Z" />
          </svg>
        </a>
        <span class="social-icon" role="img" aria-label="X / Twitter">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13.86 10.47 21.12 2h-1.72l-6.31 7.35L8.06 2H2.25l7.61 11.11L2.25 22h1.72l6.65-7.76L15.94 22h5.81l-7.89-11.53Zm-2.35 2.74-.77-1.1L4.61 3.3h2.63l4.95 7.1.77 1.1 6.44 9.25h-2.63l-5.26-7.54Z" />
          </svg>
        </span>
        <span class="social-icon" role="img" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.94 8.98H3.2V21h3.74V8.98ZM5.07 3a2.17 2.17 0 1 0 0 4.34A2.17 2.17 0 0 0 5.07 3Zm15.73 11.1c0-3.23-1.72-5.42-4.55-5.42-2.1 0-3.04 1.15-3.56 1.96V8.98H9.11V21h3.73v-5.95c0-1.57.3-3.1 2.25-3.1 1.92 0 1.95 1.8 1.95 3.2V21h3.76v-6.9Z" />
          </svg>
        </span>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">&copy; 2026 Pro Surface Works. All rights reserved.</div>
</footer>

<style>
  .footer {
    color: var(--white);
    background: var(--navy);
    padding: 72px 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr 1fr 0.8fr;
    gap: 42px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--white);
    margin-bottom: 20px;
  }

  .brand-logo {
    width: 126px;
    height: 70px;
    flex: 0 0 auto;
    object-fit: contain;
    object-position: center;
  }

  .brand-text {
    color: var(--white);
    font-size: 1.22rem;
    font-weight: 900;
    line-height: 1.05;
  }

  h3 {
    margin-bottom: 16px;
    font-size: 1.25rem;
  }

  a,
  span {
    display: block;
    color: rgba(255, 255, 255, 0.74);
    margin-bottom: 10px;
  }

  p {
    max-width: 350px;
    color: rgba(255, 255, 255, 0.72);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin: 0;
    color: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .social-icon svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .social-icon:hover,
  .social-icon:focus-visible {
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.13);
    transform: translateY(-2px) scale(1.04);
  }

  .footer-bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
