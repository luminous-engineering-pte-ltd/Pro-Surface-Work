---
type Feature = {
  title: string;
  text: string;
  icon: 'workmanship' | 'materials' | 'detail' | 'service';
};

const imageSrc = '/images/about/pro-surface-works-van.png';
const features: Feature[] = [
  {
    title: 'Professional Workmanship',
    text: 'Careful preparation, controlled methods and tidy execution across floor, marble, stone, parquet and grout work.',
    icon: 'workmanship'
  },
  {
    title: 'Quality Materials',
    text: 'Suitable products, pads, grout systems and finishing materials selected around the surface condition and usage.',
    icon: 'materials'
  },
  {
    title: 'Attention to Detail',
    text: 'Edges, joints, sheen consistency and final clean-down are handled with the same care as the main surface area.',
    icon: 'detail'
  },
  {
    title: 'Customer-Focused Service',
    text: 'Clear assessment, practical recommendations and service planning for Singapore homes and commercial spaces.',
    icon: 'service'
  }
];
---

<section class="section about-psw" aria-labelledby="about-pro-surface-works" data-about-psw>
  <div class="container about-psw__grid">
    <div class="about-psw__media about-psw__reveal" data-about-reveal style="--about-delay: 0ms">
      <div class="about-psw__image-shell" data-about-tilt>
        <img
          src={imageSrc}
          width="1456"
          height="1024"
          alt="Pro Surface Works service van in Singapore showing flooring, marble, stone and parquet care services"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-psw__badge" aria-hidden="true">
        <span>Singapore</span>
        <strong>Surface Care</strong>
      </div>
    </div>

    <div class="about-psw__content">
      <div class="eyebrow about-psw__reveal" data-about-reveal style="--about-delay: 80ms">WHO WE ARE</div>
      <h2 id="about-pro-surface-works" class="about-psw__reveal" data-about-reveal style="--about-delay: 150ms">About Pro Surface Works</h2>
      <div class="about-psw__copy about-psw__reveal" data-about-reveal style="--about-delay: 220ms">
        <p>
          Pro Surface Works is a Singapore-based flooring and surface restoration company focused on improving the appearance,
          finish and usability of well-used floors and surfaces. The team works across marble polishing, stone restoration,
          tile regrouting, epoxy grouting, parquet flooring, timber care, wood decking and general floor restoration.
        </p>
        <p>
          Each project starts with the material, site condition and expected result. From there, the work is matched to the
          surface, whether the space needs a cleaner grout line, a brighter marble finish, a renewed parquet floor or practical
          care for timber and vinyl flooring.
        </p>
      </div>

      <div class="about-psw__features" aria-label="Pro Surface Works service qualities">
        {features.map((feature, index) => (
          <article class="about-psw__feature about-psw__reveal" data-about-reveal style={`--about-delay: ${300 + index * 80}ms`}>
            <span class:list={['about-psw__icon', `about-psw__icon--${feature.icon}`]} aria-hidden="true">
              {feature.icon === 'workmanship' && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M14.8 4.2 20 9.4l-2.1 2.1-1.5-1.5-5.9 5.9v2.2H8.3l-2.6 2.6-2.1-2.1 2.6-2.6v-2.2h2.2l5.9-5.9-1.6-1.6 2.1-2.1Z" />
                </svg>
              )}
              {feature.icon === 'materials' && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M12 2.8 21 8l-9 5.2L3 8l9-5.2Zm-7.5 8.1L12 15.2l7.5-4.3 1.5 2.6-9 5.2-9-5.2 1.5-2.6Zm0 4.6L12 19.8l7.5-4.3 1.5 2.6-9 5.2-9-5.2 1.5-2.6Z" />
                </svg>
              )}
              {feature.icon === 'detail' && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M11 3h2v4h-2V3Zm0 14h2v4h-2v-4ZM3 11h4v2H3v-2Zm14 0h4v2h-4v-2Zm-9.7-5.1 1.4-1.4 2.8 2.8-1.4 1.4-2.8-2.8Zm8.5 8.5 1.4-1.4 2.8 2.8-1.4 1.4-2.8-2.8Zm2.8-8.5-2.8 2.8-1.4-1.4 2.8-2.8 1.4 1.4ZM10.1 14.4l1.4 1.4-2.8 2.8-1.4-1.4 2.8-2.8ZM12 8.8a3.2 3.2 0 1 1 0 6.4 3.2 3.2 0 0 1 0-6.4Z" />
                </svg>
              )}
              {feature.icon === 'service' && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M12 3.2a5.2 5.2 0 0 1 5.2 5.2v1.2H19a2 2 0 0 1 2 2v3.2a2 2 0 0 1-2 2h-2.8v-7.2h1V8.4a5.2 5.2 0 0 0-10.4 0v1.2h1v7.2H5a2 2 0 0 1-2-2v-3.2a2 2 0 0 1 2-2h1.8V8.4A5.2 5.2 0 0 1 12 3.2Zm1.2 13.6h3.1a4.4 4.4 0 0 1-4.3 4H9.5v-2H12a2.4 2.4 0 0 0 1.2-.3v-1.7Z" />
                </svg>
              )}
            </span>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
          </article>
        ))}
      </div>

      <a class="btn primary about-psw__cta about-psw__reveal" href="/services/" data-about-reveal style="--about-delay: 660ms" aria-label="Explore Pro Surface Works flooring and surface restoration services">
        Explore Our Services
        <span aria-hidden="true">-&gt;</span>
      </a>
    </div>
  </div>
</section>

<script>
  const aboutSections = document.querySelectorAll('[data-about-psw]');
  const reduceAboutMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  aboutSections.forEach((section) => {
    section.classList.add('about-psw--ready');

    const revealItems = section.querySelectorAll('[data-about-reveal]');
    if (reduceAboutMotion || !('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
      revealItems.forEach((item) => observer.observe(item));
    }

    const tilt = section.querySelector('[data-about-tilt]');
    if (!tilt || reduceAboutMotion) return;

    tilt.addEventListener('pointermove', (event) => {
      const rect = tilt.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width - 0.5) * 12;
      const y = ((event.clientY - rect.top) / rect.height - 0.5) * -10;
      tilt.style.setProperty('--about-tilt-x', `${y.toFixed(2)}deg`);
      tilt.style.setProperty('--about-tilt-y', `${x.toFixed(2)}deg`);
    });

    tilt.addEventListener('pointerleave', () => {
      tilt.style.removeProperty('--about-tilt-x');
      tilt.style.removeProperty('--about-tilt-y');
    });
  });
</script>

<style>
  .about-psw {
    background:
      radial-gradient(circle at 9% 12%, rgba(43, 138, 126, 0.12), transparent 24rem),
      radial-gradient(circle at 88% 16%, rgba(37, 99, 235, 0.12), transparent 24rem),
      linear-gradient(180deg, #ffffff 0%, #f5f9fd 56%, #ffffff 100%);
  }

  .about-psw::after {
    display: none;
  }

  .about-psw__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(34px, 6vw, 78px);
    align-items: center;
  }

  .about-psw__media {
    position: relative;
    min-width: 0;
    perspective: 1200px;
  }

  .about-psw__media::before,
  .about-psw__media::after {
    position: absolute;
    content: "";
    pointer-events: none;
  }

  .about-psw__media::before {
    inset: -16px 18% auto -18px;
    height: 48%;
    border: 1px solid rgba(37, 99, 235, 0.15);
    border-radius: 26px;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(6, 182, 212, 0.02));
    transform: rotate(-3deg);
  }

  .about-psw__media::after {
    right: -18px;
    bottom: 34px;
    width: 35%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(183, 155, 99, 0.18), transparent 68%);
    filter: blur(1px);
  }

  .about-psw__image-shell {
    position: relative;
    z-index: 1;
    border: 1px solid rgba(16, 32, 51, 0.12);
    border-radius: 28px;
    padding: 10px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(239, 248, 255, 0.74)),
      radial-gradient(circle at 18% 0%, rgba(6, 182, 212, 0.14), transparent 18rem);
    box-shadow: 0 28px 76px rgba(7, 21, 37, 0.16), 0 0 0 1px rgba(255, 255, 255, 0.72) inset;
    overflow: hidden;
    transform: rotateX(var(--about-tilt-x, 0deg)) rotateY(var(--about-tilt-y, 0deg));
    transition: transform 520ms var(--ease-premium), box-shadow 420ms var(--ease-premium);
    will-change: transform;
  }

  .about-psw__image-shell::after {
    position: absolute;
    inset: 10px;
    border-radius: 20px;
    content: "";
    background:
      linear-gradient(115deg, transparent 16%, rgba(255, 255, 255, 0.34), transparent 38%),
      linear-gradient(180deg, transparent 58%, rgba(7, 21, 37, 0.24));
    opacity: 0.66;
    pointer-events: none;
    transform: translateX(-28%);
    transition: transform 780ms var(--ease-premium), opacity 420ms ease;
  }

  .about-psw__image-shell:hover,
  .about-psw__image-shell:focus-within {
    box-shadow: 0 34px 88px rgba(7, 21, 37, 0.2), 0 0 0 1px rgba(255, 255, 255, 0.82) inset;
  }

  .about-psw__image-shell:hover::after,
  .about-psw__image-shell:focus-within::after {
    opacity: 0.82;
    transform: translateX(18%);
  }

  .about-psw__image-shell img {
    width: 100%;
    height: auto;
    aspect-ratio: 1456 / 1024;
    object-fit: cover;
    border-radius: 20px;
    transform: scale(1.01);
    transition: transform 900ms var(--ease-premium), filter 520ms ease;
  }

  .about-psw__image-shell:hover img,
  .about-psw__image-shell:focus-within img {
    transform: scale(1.055);
    filter: saturate(1.05) contrast(1.03);
  }

  .about-psw__badge {
    position: absolute;
    z-index: 2;
    left: clamp(18px, 5vw, 34px);
    bottom: -18px;
    display: grid;
    gap: 4px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 18px;
    padding: 14px 16px;
    color: var(--white);
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.94), rgba(6, 182, 212, 0.9));
    box-shadow: 0 20px 44px rgba(37, 99, 235, 0.24), 0 0 30px rgba(6, 182, 212, 0.16);
    backdrop-filter: blur(16px);
  }

  .about-psw__badge span {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about-psw__badge strong {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.38rem;
    line-height: 1;
  }

  .about-psw__content {
    min-width: 0;
  }

  .about-psw h2 {
    max-width: 560px;
    margin: 12px 0 20px;
    color: transparent;
    background: linear-gradient(135deg, var(--ink) 0%, var(--ink) 50%, #2563eb 78%, #0d9488 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: clamp(2.35rem, 4.5vw, 4.6rem);
  }

  .about-psw__copy {
    display: grid;
    gap: 14px;
    max-width: 640px;
  }

  .about-psw__copy p {
    margin: 0;
  }

  .about-psw__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 30px;
  }

  .about-psw__feature {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    min-width: 0;
    border: 1px solid rgba(16, 32, 51, 0.09);
    border-radius: 18px;
    padding: 16px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(248, 251, 255, 0.72)),
      radial-gradient(circle at 0% 0%, rgba(37, 99, 235, 0.08), transparent 11rem);
    box-shadow: 0 14px 34px rgba(7, 21, 37, 0.055);
    transition: transform 280ms var(--ease-premium), border-color 240ms ease, box-shadow 280ms var(--ease-premium);
  }

  .about-psw__feature:hover,
  .about-psw__feature:focus-within {
    border-color: rgba(37, 99, 235, 0.25);
    box-shadow: 0 18px 42px rgba(37, 99, 235, 0.1);
    transform: translateY(-4px);
  }

  .about-psw__icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 14px;
    color: var(--white);
    background: linear-gradient(135deg, #2563eb, #06b6d4);
    box-shadow: 0 12px 28px rgba(37, 99, 235, 0.2), 0 0 18px rgba(6, 182, 212, 0.16);
    transition: transform 300ms var(--ease-premium), box-shadow 300ms ease;
  }

  .about-psw__icon--materials {
    background: linear-gradient(135deg, #1d4ed8, #0891b2);
  }

  .about-psw__icon--detail {
    background: linear-gradient(135deg, #3b82f6, #14b8a6);
  }

  .about-psw__icon--service {
    background: linear-gradient(135deg, #0ea5e9, #06b6d4);
  }

  .about-psw__feature:hover .about-psw__icon,
  .about-psw__feature:focus-within .about-psw__icon {
    transform: translateY(-2px) rotate(-4deg) scale(1.04);
    box-shadow: 0 16px 34px rgba(37, 99, 235, 0.26);
  }

  .about-psw__icon svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .about-psw__feature h3 {
    margin: 0 0 6px;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.25;
  }

  .about-psw__feature p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.58;
  }

  .about-psw__cta {
    width: fit-content;
    margin-top: 30px;
    border-radius: 14px;
    padding: 14px 22px;
  }

  .about-psw__cta span {
    transition: transform 260ms var(--ease-premium);
  }

  .about-psw__cta:hover span,
  .about-psw__cta:focus-visible span {
    transform: translateX(4px);
  }

  .about-psw--ready .about-psw__reveal {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition:
      opacity 680ms var(--ease-premium) var(--about-delay, 0ms),
      transform 680ms var(--ease-premium) var(--about-delay, 0ms);
  }

  .about-psw--ready .about-psw__media.about-psw__reveal {
    transform: translate3d(-28px, 8px, 0) scale(0.985);
  }

  .about-psw--ready .about-psw__reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 980px) {
    .about-psw__grid {
      grid-template-columns: 1fr;
    }

    .about-psw__content {
      max-width: 760px;
    }
  }

  @media (max-width: 680px) {
    .about-psw__features {
      grid-template-columns: 1fr;
    }

    .about-psw__image-shell {
      border-radius: 20px;
      padding: 8px;
    }

    .about-psw__image-shell img,
    .about-psw__image-shell::after {
      border-radius: 14px;
    }

    .about-psw__badge {
      position: relative;
      left: auto;
      bottom: auto;
      width: fit-content;
      margin: -24px 0 0 16px;
    }

    .about-psw__cta {
      width: 100%;
    }
  }

  @media (max-width: 380px) {
    .about-psw__feature {
      grid-template-columns: 1fr;
    }

    .about-psw__icon {
      width: 40px;
      height: 40px;
    }
  }

  @media (hover: none) {
    .about-psw__image-shell:hover img,
    .about-psw__feature:hover {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-psw__image-shell,
    .about-psw__image-shell img,
    .about-psw__image-shell::after,
    .about-psw__feature,
    .about-psw__icon,
    .about-psw__cta span,
    .about-psw--ready .about-psw__reveal {
      transition-duration: 0.01ms !important;
      transform: none !important;
    }

    .about-psw--ready .about-psw__reveal {
      opacity: 1;
    }
  }
</style>
