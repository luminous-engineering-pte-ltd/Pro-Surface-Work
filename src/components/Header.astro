---
import { services, navLinks } from '@/data/services';
---

<header class="site-header">
  <div class="nav-wrap">
    <a class="brand" href="/" aria-label="Pro Surface Works home">
      <span class="brand-mark">PS</span>
      <span>Pro Surface Works</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navLinks.map((link) => (
        link.label === 'Services' ? (
          <div class="nav-service" data-services-menu>
            <button class="services-trigger" type="button" data-services-toggle aria-expanded="false" aria-controls="services-mega">
              <span>{link.label}</span>
              <span class="chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="mega" id="services-mega" aria-label="Services menu">
              <div class="mega-inner">
                <div class="mega-kicker">Services</div>
                {services.map((service) => (
                  <article class="mega-item">
                    <a href={`/services/${service.slug}`} class="mega-title" data-close-services>
                      <span class="mega-number">{service.number}</span>
                      <strong>{service.title}</strong>
                    </a>
                    <div class="mega-subs">
                      {service.subServices.map((sub) => (
                        <a href={`/services/${service.slug}/${sub.slug}`} data-close-services>{sub.title}</a>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={link.href} data-close-services>{link.label}</a>
        )
      ))}
    </nav>
    <div class="nav-actions">
      <a class="call-link" href="tel:+6581836772" aria-label="Call Pro Surface Works">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.24.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z" />
        </svg>
      </a>
      <a class="quote-link" href="/contact" data-close-services>Get a Quote</a>
    </div>
    <button class="menu-btn" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
  <div class="mobile-panel">
    <a href="/">Home</a>
    <div class="mobile-services-wrap">
      <button class="mobile-services-toggle" type="button" data-mobile-services-toggle aria-expanded="false">
        <span>Services</span>
        <span class="chevron" aria-hidden="true">⌄</span>
      </button>
      <div class="mobile-services">
        {services.map((service) => (
          <div class="mobile-service">
            <button type="button" class="mobile-service-toggle" aria-expanded="false">
              <span>{service.title}</span>
              <span class="mobile-service-chevron" aria-hidden="true"></span>
            </button>
            <div>
              <a href={`/services/${service.slug}`}>Overview</a>
              {service.subServices.map((sub) => (
                <a href={`/services/${service.slug}/${sub.slug}`}>{sub.title}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a class="quote-link mobile" href="/contact">Get a Quote</a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    color: var(--white);
    transition: background 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .site-header.is-scrolled,
  .site-header.services-open,
  body.menu-open .site-header {
    color: var(--ink);
    background: rgba(247, 244, 237, 0.92);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 14px 40px rgba(7, 21, 37, 0.08);
    backdrop-filter: blur(18px);
  }

  .nav-wrap {
    width: min(1240px, calc(100% - 40px));
    height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-inline: auto;
  }

  .brand,
  .desktop-nav,
  .nav-actions,
  .quote-link,
  .call-link {
    display: inline-flex;
    align-items: center;
  }

  .brand {
    gap: 12px;
    font-weight: 900;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.36);
    border-radius: 50%;
    color: var(--white);
    background: linear-gradient(135deg, var(--navy), var(--green-2));
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.1rem;
  }

  .desktop-nav {
    gap: 28px;
    font-weight: 800;
  }

  .desktop-nav > a {
    padding: 30px 0;
  }

  .desktop-nav a,
  .services-trigger {
    transition: color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .desktop-nav a:hover {
    color: var(--gold);
  }

  .nav-actions {
    gap: 10px;
  }

  .services-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 42px;
    border: 0;
    border-radius: 999px;
    padding: 9px 13px;
    color: inherit;
    background: transparent;
    font-weight: 900;
    line-height: 1;
    cursor: pointer;
  }

  .services-trigger:hover,
  .nav-service.is-open .services-trigger {
    color: var(--white);
    background: rgba(31, 90, 73, 0.88);
    box-shadow: 0 10px 26px rgba(7, 21, 37, 0.16);
  }

  .site-header.is-scrolled .services-trigger:hover,
  .site-header.services-open .services-trigger,
  .site-header.is-scrolled .nav-service.is-open .services-trigger {
    color: var(--white);
    background: var(--green-2);
    box-shadow: 0 10px 24px rgba(31, 90, 73, 0.2);
  }

  .chevron {
    display: inline-block;
    width: 0.56rem;
    height: 0.56rem;
    flex: 0 0 auto;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    font-size: 0;
    line-height: 0;
    transform: rotate(45deg);
    transform-origin: 50% 50%;
    transition: transform 180ms ease;
  }

  .nav-service.is-open .chevron,
  .mobile-services-wrap.is-open > .mobile-services-toggle .chevron {
    transform: rotate(225deg);
  }

  .quote-link {
    min-height: 42px;
    justify-content: center;
    border-radius: var(--radius);
    padding: 11px 17px;
    color: var(--white);
    background: var(--green-2);
    font-weight: 900;
  }

  .call-link {
    width: 42px;
    height: 42px;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 50%;
    color: var(--white);
    background: rgba(31, 90, 73, 0.82);
    box-shadow: 0 12px 28px rgba(7, 21, 37, 0.12);
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .site-header.is-scrolled .call-link,
  .site-header.services-open .call-link,
  body.menu-open .site-header .call-link {
    border-color: rgba(31, 90, 73, 0.18);
    color: var(--white);
    background: var(--green-2);
  }

  .call-link:hover {
    transform: translateY(-2px);
    background: var(--green);
    box-shadow: 0 16px 32px rgba(31, 90, 73, 0.24);
  }

  .call-link svg {
    width: 1.08rem;
    height: 1.08rem;
    display: block;
    fill: currentColor;
  }

  .mega {
    position: fixed;
    top: 78px;
    left: 50%;
    width: min(1240px, calc(100% - 40px));
    max-height: calc(100vh - 110px);
    overflow: auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 10px) scale(0.985);
    transform-origin: top center;
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
  }

  .nav-service.is-open .mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
  }

  .mega-inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px 20px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: var(--shadow);
    color: var(--ink);
    backdrop-filter: blur(20px);
  }

  .mega-kicker {
    grid-column: 1 / -1;
    color: var(--green-2);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mega-item {
    min-width: 0;
    padding: 16px;
    border: 1px solid rgba(16, 32, 51, 0.1);
    border-radius: var(--radius);
    background: linear-gradient(180deg, #ffffff, #fbfaf6);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .mega-item:hover {
    border-color: rgba(31, 90, 73, 0.28);
    box-shadow: 0 12px 28px rgba(7, 21, 37, 0.08);
    transform: translateY(-2px);
  }

  .mega-title {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    margin-bottom: 12px;
  }

  .mega-number {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(31, 90, 73, 0.24);
    border-radius: 50%;
    color: var(--green-2);
    background: rgba(31, 90, 73, 0.08);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .mega-title strong {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.18rem;
    line-height: 1.05;
  }

  .mega-subs {
    display: grid;
    gap: 8px;
    padding-left: 44px;
  }

  .mega-subs a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 34px;
    margin-left: -10px;
    padding: 8px 10px 8px 22px;
    border-radius: 6px;
    color: #51606d;
    font-size: 0.84rem;
    font-weight: 800;
    line-height: 1.35;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .mega-subs a::before {
    position: absolute;
    left: -13px;
    content: "•";
    color: var(--green-2);
  }

  .mega-subs a:hover {
    color: var(--green);
  }

  .mega-subs a::before {
    left: 9px;
    transition: color 180ms ease;
  }

  .mega-subs a:hover {
    background: rgba(31, 90, 73, 0.08);
    transform: translateX(2px);
  }

  .menu-btn,
  .mobile-panel {
    display: none;
  }

  @media (max-width: 1080px) {
    .desktop-nav,
    .quote-link:not(.mobile) {
      display: none;
    }

    .site-header {
      background: rgba(7, 21, 37, 0.22);
      backdrop-filter: blur(12px);
    }

    .menu-btn {
      width: 46px;
      height: 46px;
      display: grid;
      gap: 6px;
      place-content: center;
      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: 50%;
      color: inherit;
      background: rgba(255, 255, 255, 0.08);
      transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
    }

    .call-link {
      width: 46px;
      height: 46px;
      border-color: rgba(255, 255, 255, 0.32);
    }

    .nav-actions {
      margin-left: auto;
    }

    .site-header.is-scrolled .call-link,
    body.menu-open .site-header .call-link {
      border-color: rgba(31, 90, 73, 0.18);
    }

    .site-header.is-scrolled .menu-btn,
    body.menu-open .menu-btn {
      border-color: rgba(16, 32, 51, 0.18);
      background: rgba(255, 255, 255, 0.72);
    }

    .menu-btn:hover {
      transform: translateY(-1px);
      background: rgba(31, 90, 73, 0.12);
    }

    .menu-btn span {
      width: 19px;
      height: 2px;
      border-radius: 999px;
      background: currentColor;
      transition: transform 180ms ease, opacity 180ms ease;
    }

    body.menu-open .menu-btn span:first-child {
      transform: translateY(4px) rotate(45deg);
    }

    body.menu-open .menu-btn span:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }

    .mobile-panel {
      position: fixed;
      inset: 78px 0 auto 0;
      max-height: calc(100vh - 78px);
      display: grid;
      gap: 8px;
      overflow: auto;
      padding: 16px 20px 28px;
      background: rgba(247, 244, 237, 0.98);
      color: var(--ink);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 22px 55px rgba(7, 21, 37, 0.14);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-12px);
      transition: opacity 220ms ease, transform 220ms ease, visibility 220ms ease;
      backdrop-filter: blur(18px);
    }

    body.menu-open .mobile-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mobile-panel > a,
    .mobile-services-toggle {
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      border: 0;
      border-radius: var(--radius);
      color: var(--ink);
      background: transparent;
      padding: 0 14px;
      font-size: 1rem;
      font-weight: 850;
      text-align: left;
      transition: color 180ms ease, background 180ms ease, transform 180ms ease;
    }

    .mobile-panel > a:hover,
    .mobile-services-toggle:hover,
    .mobile-services-wrap.is-open > .mobile-services-toggle {
      color: var(--green);
      background: rgba(31, 90, 73, 0.08);
      transform: translateX(1px);
    }

    .mobile-services-wrap {
      overflow: hidden;
      border: 1px solid rgba(16, 32, 51, 0.1);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.52);
    }

    .mobile-services {
      display: grid;
      max-height: 0;
      overflow: hidden;
      padding: 0 8px;
      opacity: 0;
      transition: max-height 260ms ease, opacity 200ms ease, padding 220ms ease;
    }

    .mobile-services-wrap.is-open .mobile-services {
      max-height: 75vh;
      gap: 6px;
      padding: 4px 8px 10px;
      opacity: 1;
    }

    .mobile-services-toggle {
      gap: 8px;
    }

    .mobile-services-toggle span:first-child,
    .mobile-service-toggle span:first-child {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .mobile-service-toggle {
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      width: 100%;
      border: 0;
      border-bottom: 1px solid rgba(16, 32, 51, 0.1);
      border-radius: 6px;
      color: var(--ink);
      background: transparent;
      padding: 12px 12px;
      font-size: 0.95rem;
      font-weight: 850;
      line-height: 1.25;
      text-align: left;
      transition: color 180ms ease, background 180ms ease;
    }

    .mobile-service-toggle:hover,
    .mobile-service.is-open .mobile-service-toggle {
      color: var(--green);
      background: rgba(31, 90, 73, 0.08);
    }

    .mobile-service-chevron {
      width: 0.52rem;
      height: 0.52rem;
      display: inline-block;
      flex: 0 0 auto;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg);
      transform-origin: 50% 50%;
      transition: transform 180ms ease;
    }

    .mobile-service.is-open .mobile-service-chevron {
      transform: rotate(225deg);
    }

    .mobile-service div {
      display: grid;
      max-height: 0;
      overflow: hidden;
      padding-left: 12px;
      opacity: 0;
      transition: max-height 240ms ease, opacity 200ms ease, padding 220ms ease;
    }

    .mobile-service.is-open div {
      max-height: 420px;
      padding: 6px 0 10px 16px;
      opacity: 1;
    }

    .mobile-service div a {
      min-height: 42px;
      display: flex;
      align-items: center;
      width: 100%;
      border-radius: 6px;
      color: var(--muted);
      font-size: 0.92rem;
      font-weight: 780;
      line-height: 1.35;
      padding: 9px 12px;
      transition: color 180ms ease, background 180ms ease, transform 180ms ease;
    }

    .mobile-service div a:hover {
      color: var(--green);
      background: rgba(31, 90, 73, 0.08);
      transform: translateX(2px);
    }

    .quote-link.mobile {
      min-height: 52px;
      margin-top: 8px;
      color: var(--white);
      border: 0;
      justify-content: center;
      box-shadow: 0 12px 28px rgba(31, 90, 73, 0.18);
    }
  }

  @media (max-width: 520px) {
    .nav-wrap {
      width: calc(100% - 28px);
      max-width: 1240px;
      height: 72px;
      gap: 12px;
    }

    .brand {
      gap: 10px;
    }

    .brand-mark {
      width: 39px;
      height: 39px;
    }

    .call-link {
      width: 42px;
      height: 42px;
    }

    .brand span:last-child {
      max-width: 154px;
      line-height: 1.05;
      font-size: 0.95rem;
    }

    .mobile-panel {
      inset: 72px 0 auto 0;
      max-height: calc(100vh - 72px);
      padding: 14px 14px 24px;
    }
  }
</style>
