---
import { company } from '@/data/services';
---

<section class="cta section">
  <div class="container">
    <div class="eyebrow">Quote Request</div>
    <h2>Ready to Restore Your Surface?</h2>
    <p>Tell us what needs fixing and get a clear quote for your project.</p>
    <div class="hero-actions">
      <a class="btn light" href="/contact">Get a Free Quote</a>
      <a class="btn ghost" href={`https://wa.me/${company.whatsapp}`}>WhatsApp Us {company.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    color: var(--white);
    background:
      radial-gradient(circle at 16% 20%, rgba(6, 182, 212, 0.24), transparent 24rem),
      radial-gradient(circle at 78% 18%, rgba(124, 58, 237, 0.24), transparent 24rem),
      radial-gradient(circle at 88% 74%, rgba(183, 155, 99, 0.2), transparent 24rem),
      linear-gradient(105deg, rgba(7, 21, 37, 0.95), rgba(29, 78, 216, 0.84) 54%, rgba(91, 33, 182, 0.82)),
      url("https://images.unsplash.com/photo-1600607688969-a5bfcd646154?auto=format&fit=crop&w=1600&q=80") center / cover;
  }

  .cta::before {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    background: linear-gradient(115deg, transparent, rgba(255, 255, 255, 0.08), transparent);
    transform: translateX(-70%);
    animation: cta-sheen 7s var(--ease-premium) infinite;
  }

  .container {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 30px;
    padding: clamp(34px, 6vw, 64px);
    background: rgba(7, 21, 37, 0.28);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 24px 70px rgba(0,0,0,.16);
    backdrop-filter: blur(8px);
  }

  .container::after {
    position: absolute;
    right: clamp(18px, 5vw, 70px);
    top: clamp(18px, 4vw, 54px);
    width: 112px;
    height: 112px;
    content: "";
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 32px;
    background: linear-gradient(135deg, rgba(255,255,255,.16), rgba(255,255,255,.02));
    transform: rotate(12deg);
    pointer-events: none;
  }

  h2 {
    max-width: 700px;
  }

  p {
    max-width: 520px;
    color: rgba(255, 255, 255, 0.78);
  }

  @keyframes cta-sheen {
    0%, 42% { transform: translateX(-70%); opacity: 0; }
    52% { opacity: 1; }
    70%, 100% { transform: translateX(70%); opacity: 0; }
  }
</style>
